# Copy to .env and edit. Booleans: true/false.
DEBUG=true
# Required when DEBUG=false. Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave empty for SQLite (db.sqlite3). Supabase (session pooler, see README "Database: Supabase"):
# DATABASE_URL=postgres://insureremind_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Optional: run the test suite on Postgres (use the DIRECT host, not the pooler). Empty = tests use SQLite.
# TEST_DATABASE_URL=postgres://insureremind_app:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
TEST_DATABASE_URL=
SECURE_SSL_REDIRECT=true

# --- AI extraction (OpenRouter; model etc. live in config/llm.toml) ---
# Key from https://openrouter.ai/keys. In production use a real env var / secret store.
# Optional overrides: OPENROUTER_MODEL=, LLM_CONFIG_PATH=
OPENROUTER_API_KEY=

# --- Agency / reminders ---
AGENCY_NAME=My Insurance Agency
REMINDER_DAYS=30,15,7,1
AGENT_NOTIFY_EMAIL=
AGENT_NOTIFY_PHONE=

# --- Email (console backend by default) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=reminders@example.com

# --- WhatsApp: console (log only) or meta (Cloud API) ---
WHATSAPP_BACKEND=console
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=policy_expiry_reminder
WHATSAPP_TEMPLATE_LANG=en

# --- Document storage: local (media/ folder) or azure (Blob Storage) ---
STORAGE_BACKEND=local
# Azure only: storage account + private container. Auth is by managed identity (az login locally), no keys.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=documents
# Azure only, local testing only: connection string overrides managed identity. Never set in production.
# AZURE_STORAGE_CONNECTION_STRING=

# --- Operations (Azure) ---
# Shared secret for POST /internal/cron/send-reminders/ (X-Cron-Token header). Empty = endpoint disabled (404).
CRON_TOKEN=
# Application Insights connection string. Empty = telemetry off.
APPLICATIONINSIGHTS_CONNECTION_STRING=
