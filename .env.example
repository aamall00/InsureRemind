# Copy to .env and edit. Booleans: true/false.
DEBUG=true
# Required when DEBUG=false. Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave empty for SQLite (db.sqlite3). Postgres example:
DATABASE_URL=
SECURE_SSL_REDIRECT=true

# --- AI extraction (OpenRouter; model etc. live in config/llm.toml) ---
# Key from https://openrouter.ai/keys. In production use a real env var / secret store.
# Optional overrides: OPENROUTER_MODEL=, LLM_CONFIG_PATH=
OPENROUTER_API_KEY=

# --- Agency / reminders ---
AGENCY_NAME=My Insurance Agency
REMINDER_DAYS=30,15,7,1
AGENT_NOTIFY_EMAIL=
AGENT_NOTIFY_PHONE=

# --- Email (console backend by default) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=reminders@example.com

# --- WhatsApp: console (log only) or meta (Cloud API) ---
WHATSAPP_BACKEND=console
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=policy_expiry_reminder
WHATSAPP_TEMPLATE_LANG=en
